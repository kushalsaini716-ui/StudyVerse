generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        String   @id @default(cuid())
  fileName  String
  college   String
  branch    String
  year      String   @default("1")
  fileUrl   String
  createdAt DateTime @default(now())
}
